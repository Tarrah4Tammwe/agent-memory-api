# Required. Server-side only — never expose to clients or RapidAPI consumers.
ANTHROPIC_API_KEY=

# Required in production. Copy from the RapidAPI provider dashboard
# (Definition → Security → X-RapidAPI-Proxy-Secret).
# POST /api/summarise and POST /api/extract reject requests that do not
# present a matching x-rapidapi-proxy-secret header.
RAPIDAPI_PROXY_SECRET=

# Optional. Direct/Vercel testing key accepted via X-API-Key or
# Authorization: Bearer. Use this for local production-mode checks;
# consumers should still go through RapidAPI.
API_ACCESS_KEY=
